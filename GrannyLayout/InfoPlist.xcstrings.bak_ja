{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "祖母方格排版"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "祖母方格排版"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granny Square Layout"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用来拍下你摆好的方块，自动切开帮你排版。照片只存在你的手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用來拍下你擺好的方塊，自動切開幫你排版。照片只存在你的手機上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of your laid-out squares so the app can arrange them. Photos stay on your iPhone."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从相册选一张摆好方块的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相簿選一張擺好方塊的照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a photo of your laid-out squares."
          }
        }
      }
    }
  },
  "version": "1.0"
}
